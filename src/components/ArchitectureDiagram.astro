---
import type { ArchitectureBlock } from '../data/site'

interface Props {
  title: string
  blocks: ArchitectureBlock[]
}
const { title, blocks } = Astro.props
---
<div class="arch-diagram" aria-label={title}>
  <div class="arch-diagram__header">
    <p class="arch-diagram__eyebrow">SYSTEM PIPELINE // ARCHITECTURE</p>
    <h3>{title}</h3>
  </div>
  <div class="arch-diagram__grid">
    {blocks.map((b, idx) => (
      <div class="arch-block">
        <div class="arch-block__top">
          <span class="arch-block__step">{b.step}</span>
          <span class="arch-block__tech">{b.tech}</span>
        </div>
        <h4 class="arch-block__title">{b.title}</h4>
        <p class="arch-block__desc">{b.desc}</p>
        {idx < blocks.length - 1 && (
          <div class="arch-block__arrow" aria-hidden="true">→</div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .arch-diagram {
    margin: 2.5rem 0 3.5rem;
    padding: 2.2rem 2.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .arch-diagram__header {
    margin-bottom: 2rem;
  }

  .arch-diagram__eyebrow {
    margin-bottom: 0.4rem;
    color: var(--accent-cyan);
    font: 600 0.76rem/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .arch-diagram h3 {
    margin: 0;
    font-size: 1.45rem;
    color: var(--text-primary);
  }

  .arch-diagram__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    position: relative;
  }

  .arch-block {
    position: relative;
    padding: 1.6rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease;
  }

  .arch-block:hover {
    border-color: var(--border-hover);
  }

  .arch-block__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .arch-block__step {
    font: 700 0.82rem var(--font-mono);
    color: var(--accent-cyan);
  }

  .arch-block__tech {
    font: 600 0.72rem var(--font-mono);
    color: var(--text-muted);
    background: rgba(0, 255, 213, 0.05);
    border: 1px solid rgba(0, 255, 213, 0.18);
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.55rem;
  }

  .arch-block__title {
    margin: 0 0 0.5rem;
    font: 700 1.05rem/1.2 var(--font-sans);
    color: var(--text-primary);
  }

  .arch-block__desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .arch-block__arrow {
    position: absolute;
    right: -1.15rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent-cyan);
    font: 700 1.2rem var(--font-mono);
    z-index: 2;
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .arch-diagram__grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .arch-block__arrow {
      right: 50%;
      top: auto;
      bottom: -1rem;
      transform: translateX(50%) rotate(90deg);
    }
  }
</style>

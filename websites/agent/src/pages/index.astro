const title = 'Agent — work in progress'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A separate workspace for the agent-repository portfolio concept." />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        font-family: system-ui, sans-serif;
        background: #f5f5f4;
        color: #292524;
      }

      body {
        display: grid;
        min-height: 100vh;
        margin: 0;
        place-items: center;
      }

      main {
        width: min(42rem, calc(100% - 3rem));
        padding: 2rem 0;
      }

      p {
        color: #57534e;
        line-height: 1.7;
      }
    </style>
  </head>
  <body>
    <main>
      <p>Separate Astro application · scaffold 0.1.0</p>
      <h1>Agent portfolio</h1>
      <p>This site has its own source, release history and Scrum. The editor interface and profile content have not been implemented yet.</p>
      <p>The public deployment still uses Neuron Mesh until the root selector is changed deliberately.</p>
    </main>
  </body>
</html>

---
import { readmeIntro, readmeIntroEs } from '../data/readme-intro'
import profile from '../data/profile.json'
import documentGraph from '../data/document-graph.json'
import experienceStops from '../data/experience-stops.json'
import localizedPaths from '../data/localized-paths.json'
import '../styles/workbench.css'

const pageTitle = 'Juan Larrondo · Portfolio (Alpha)'
const documents = profile.documents
const rootFileOrder = ['README.md', 'AGENTS.md', 'SOUL.md', 'Trajectory.md', 'Contact.md']
const rootFileRank = new Map(rootFileOrder.map((path, index) => [path, index]))
const rootDocuments = documents
  .filter((document) => !document.path.includes('/'))
  .sort((first, second) => (rootFileRank.get(first.path) ?? 999) - (rootFileRank.get(second.path) ?? 999))
const skillDocuments = documents.filter((document) => document.path.startsWith('skills/'))
const projectDocuments = documents.filter((document) => document.path.startsWith('projects/'))
const baseUrl = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon-jl.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Juan Larrondo's portfolio in development: experience, skills and projects in a VS Code inspired interface."
    />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#181818" />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const stored = localStorage.getItem('agent-theme')
        const choice = ['dark', 'light', 'monokai', 'solarized', 'system'].includes(stored) ? stored : 'dark'
        document.documentElement.dataset.themeChoice = choice
        document.documentElement.dataset.theme = choice === 'system'
          ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
          : choice
      } catch {
        document.documentElement.dataset.themeChoice = 'dark'
        document.documentElement.dataset.theme = 'dark'
      }
    </script>
  </head>
  <body>
    <div class="app-shell">
      <header class="titlebar" aria-label="Title bar">
        <button class="titlebar-brand" type="button" aria-label="Open README.md">
          <span class="brand-mark" aria-hidden="true">JL</span>
          <span class="titlebar-name">Juan / portfolio</span>
        </button>
        <div class="titlebar-location" id="titlebar-location">README.md — Juan</div>
        <div class="titlebar-actions">
          <button class="language-switch" type="button" data-current-language="en" aria-label="Switch language to Spanish">
            <span data-language-option="es" lang="es">ES</span>
            <span data-language-option="en" lang="en">EN</span>
          </button>
          <label class="visually-hidden" for="theme-select">Visual theme</label>
          <select id="theme-select" class="theme-select" aria-label="Visual theme">
            <option value="dark">VS Code oscuro</option>
            <option value="light">VS Code claro</option>
            <option value="monokai">Monokai</option>
            <option value="solarized">Solarized Dark</option>
            <option value="system">Tema: sistema</option>
          </select>
          <span class="alpha-label">Preview · Alpha</span>
        </div>
      </header>

      <div class="workbench" data-mobile-sidebar-open="false">
        <aside class="sidebar" id="file-sidebar" aria-label="File explorer">
          <div class="sidebar-heading">
            <span id="sidebar-title">Explorer</span>
            <button class="sidebar-close" type="button" aria-label="Close file explorer">×</button>
          </div>
          <div class="sidebar-scroll">
            <section class="view-content" aria-label="File tree">
              <button
                class="root-folder"
                type="button"
                data-folder="root"
                data-target="workspace-files"
                aria-expanded="true"
                aria-controls="workspace-files"
              >
                <svg class="tree-chevron" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m5.5 3.5 5 4.5-5 4.5" />
                </svg>
                <span class="folder-glyph ui-icon" aria-hidden="true"></span>
                <span>Juan/</span>
              </button>

              <ul class="tree-group" id="workspace-files">
                {rootDocuments.map((document) => (
                  <li><button class="tree-file" type="button" data-file={document.path} aria-current={document.path === 'README.md' ? 'page' : undefined}>
                    <span class="file-glyph ui-icon" aria-hidden="true"></span><span class="tree-file-label">{document.path}</span>
                  </button></li>
                ))}
                <li>
                  <button class="tree-folder" type="button" data-folder="skills" data-target="skills-files" aria-expanded="true" aria-controls="skills-files">
                    <svg class="tree-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m5.5 3.5 5 4.5-5 4.5" /></svg>
                    <span class="folder-glyph ui-icon" aria-hidden="true"></span><span>skills</span>
                  </button>
                  <ul class="tree-children" id="skills-files">
                    {skillDocuments.map((document) => (
                      <li><button class="tree-file" type="button" data-file={document.path}>
                        <span class="file-glyph ui-icon" aria-hidden="true"></span><span class="tree-file-label">{document.path.split('/').at(-1)}</span>
                      </button></li>
                    ))}
                  </ul>
                </li>
                <li>
                  <button class="tree-folder" type="button" data-folder="projects" data-target="project-files" aria-expanded="true" aria-controls="project-files">
                    <svg class="tree-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m5.5 3.5 5 4.5-5 4.5" /></svg>
                    <span class="folder-glyph ui-icon" aria-hidden="true"></span><span>projects</span>
                  </button>
                  <ul class="tree-children" id="project-files">
                    {projectDocuments.map((document) => (
                      <li><button class="tree-file" type="button" data-file={document.path}>
                        <span class="file-glyph ui-icon" aria-hidden="true"></span><span class="tree-file-label">{document.path.split('/').at(-1)}</span>
                      </button></li>
                    ))}
                  </ul>
                </li>
              </ul>
            </section>
          </div>
        </aside>

        <main class="editor" aria-label="Portfolio de Juan">
          <div class="tabs-bar" aria-label="Archivos abiertos">
            <button class="mobile-files-toggle" type="button" aria-controls="file-sidebar" aria-expanded="false"><span class="ui-icon icon-files" aria-hidden="true"></span><span>Explorer</span></button>
            <div class="tabs-list" id="tabs-list"></div>
          </div>
          <div class="breadcrumbs" id="breadcrumbs" aria-label="Ruta del archivo">
            <button class="breadcrumb-folder" id="breadcrumb-root" type="button" aria-controls="breadcrumb-menu" aria-expanded="false"><span class="breadcrumb-root-icon ui-icon" aria-hidden="true"></span><span>Juan</span></button><span id="breadcrumb-path"></span>
            <span class="breadcrumb-separator" aria-hidden="true">›</span><span class="breadcrumb-current-icon" id="breadcrumb-current-icon" data-file="README.md"><span class="file-glyph ui-icon" aria-hidden="true"></span></span>
            <span class="breadcrumb-file" id="breadcrumb-file">README.md</span>
            <div class="breadcrumb-menu" id="breadcrumb-menu" role="region" aria-label="Files in Juan" hidden>
              <div class="breadcrumb-menu-heading"><span id="breadcrumb-menu-title">Juan/</span><small id="breadcrumb-menu-hint">Choose a file</small></div>
              <div class="breadcrumb-menu-list" id="breadcrumb-menu-list"></div>
            </div>
          </div>
          <div class="editor-scroll" role="region" tabindex="0" aria-label="Scrollable portfolio content">
            <article class="readme-preview" id="readme-preview" aria-label="Vista previa de README.md">
              <div class="readme-eyebrow">
                <span class="readme-eyebrow-line" aria-hidden="true"></span>
                <span>README.md</span>
                <span class="readme-eyebrow-index">01 / portfolio</span>
              </div>
              <div class="readme-layout">
                <div class="readme-copy">
                  <h1>{readmeIntro.greeting}<br /><em>{readmeIntro.invitation}</em></h1>
                  <p class="readme-lead">{readmeIntro.lead}</p>
                  <div class="readme-guide">
                    <span class="guide-arrow" aria-hidden="true">↖</span>
                    <p>{readmeIntro.guide}</p>
                  </div>
                  <nav class="readme-routes" aria-label="Start exploring">
                    <a data-readme-file="Trajectory.md" href="#/en/Trajectory.md">Trajectory</a>
                    <a data-readme-file="projects/README.md" href="#/en/projects%2FREADME.md">Projects</a>
                    <a data-readme-file="SOUL.md" href="#/en/SOUL.md">About me</a>
                    <a data-readme-file="Contact.md" href="#/en/Contact.md">Contact</a>
                  </nav>
                </div>
                <div class="readme-art" aria-hidden="true">
                  <div class="art-file art-file-back">
                    <span>skills/</span>
                    <i></i><i></i><i></i>
                  </div>
                  <div class="art-file art-file-front">
                    <span>README.md</span>
                    <i></i><i></i><i></i><i></i>
                  </div>
                  <div class="art-folder">
                    <span class="art-folder-mark">JL<span class="art-folder-spark">✳</span></span>
                    <span class="art-folder-caption">Juan / portfolio</span>
                  </div>
                  <span class="art-coordinate art-coordinate-top">01 — OPEN</span>
                  <span class="art-coordinate art-coordinate-bottom">// CURIOUS BY DESIGN</span>
                </div>
              </div>
              <div class="readme-bottom">
                <span class="readme-bottom-label">Development note</span>
                <p>This version is still in development. <a href={`${baseUrl}icons/codicons/ATTRIBUTION.txt`}>Icon credits</a></p>
                <a class="readme-agent-link" href={`${baseUrl}for-agents/`}>For agents ↗</a>
              </div>
            </article>
            <section class="readme-explore" id="readme-explore" aria-label="Explore the README" hidden></section>
            <article class="profile-preview" id="profile-preview" aria-live="polite" hidden></article>
            <article class="empty-editor" id="empty-editor" hidden><h1>Everything is closed for now.</h1><p>Open a file from the tree, or return to README.</p><button class="empty-readme" type="button">Open README.md</button></article>
          </div>
        </main>

        <button class="mobile-scrim" type="button" aria-label="Cerrar panel lateral" hidden></button>
      </div>

      <footer class="statusbar" aria-label="Estado del workspace">
        <div class="status-group">
          <span class="status-item">Juan · in development</span>
        </div>
        <div class="status-group">
          <span class="status-item is-secondary" id="status-file">README.md</span>
          <span class="status-item is-secondary" id="status-locale">EN</span>
        </div>
      </footer>
    </div>

    <script define:vars={{ profileDocuments: documents, rootFileOrder, graphNodes: documentGraph.nodes, experienceStops, localizedPaths, baseUrl, readmeContent: readmeIntro, readmeSpanish: readmeIntroEs }}>
      const byPath = Object.fromEntries(profileDocuments.map((item) => [item.path, item]))
      const graphByPath = Object.fromEntries(graphNodes.map((item) => [item.path, item]))
      const workbench = document.querySelector('.workbench')
      const sidebar = document.querySelector('.sidebar')
      const filesToggle = document.querySelector('.mobile-files-toggle')
      const sidebarClose = document.querySelector('.sidebar-close')
      const brandButton = document.querySelector('.titlebar-brand')
      const languageSwitch = document.querySelector('.language-switch')
      const readmePreview = document.querySelector('#readme-preview')
      const readmeExplore = document.querySelector('#readme-explore')
      const profilePreview = document.querySelector('#profile-preview')
      const emptyEditor = document.querySelector('#empty-editor')
      const tabsList = document.querySelector('#tabs-list')
      const titlebarLocation = document.querySelector('#titlebar-location')
      const breadcrumbFile = document.querySelector('#breadcrumb-file')
      const breadcrumbCurrentIcon = document.querySelector('#breadcrumb-current-icon')
      const breadcrumbPath = document.querySelector('#breadcrumb-path')
      const breadcrumbRoot = document.querySelector('#breadcrumb-root')
      const breadcrumbs = document.querySelector('#breadcrumbs')
      const editorScroll = document.querySelector('.editor-scroll')
      const breadcrumbMenu = document.querySelector('#breadcrumb-menu')
      const breadcrumbMenuList = document.querySelector('#breadcrumb-menu-list')
      const statusFile = document.querySelector('#status-file')
      const statusLocale = document.querySelector('#status-locale')
      const themeSelect = document.querySelector('#theme-select')
      const scrim = document.querySelector('.mobile-scrim')
      const mobileViewport = window.matchMedia('(max-width: 760px)')
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      const systemTheme = window.matchMedia('(prefers-color-scheme: light)')
      const openTabs = ['README.md']
      let activePath = 'README.md'
      let openBreadcrumbTrigger = null
      let routeState = null
      let routeResizeObserver = null
      let routeFrame = null
      let routeLayoutFrame = null
      let markerAnimationFrame = null
      let markerAnimationTime = null
      let markerInertiaFrame = null
      let markerInertiaTime = null
      let autoScrollFrame = null
      let autoScrollAnchorY = null
      let autoScrollPointerY = null
      let autoScrollTime = null
      // AG-052: direct path-distance input; camera follows the same sampled point.
      const directPathInputEnabled = true
      const timelineCameraEnabled = true
      let locale = (() => { try { return localStorage.getItem('agent-language') === 'es' ? 'es' : 'en' } catch { return 'en' } })()

      function canonicalPath(path) {
        if (path === 'Experience.md') return 'Trajectory.md'
        return Object.entries(localizedPaths).find(([, localized]) => localized === path)?.[0] ?? path
      }

      function displayPath(path, language = locale) {
        return language === 'es' ? (localizedPaths[path] ?? path) : path
      }

      function displayFolder(path, language = locale) {
        return language === 'es' && path === 'projects' ? 'proyectos' : path
      }

      function linkFor(path, language = locale) {
        return `#/${language}/${encodeURIComponent(displayPath(canonicalPath(path), language))}`
      }

      function routeTo(path, language = locale) {
        path = path ? canonicalPath(path) : null
        const target = path ? linkFor(path, language) : `#/${language}/_empty`
        if (location.hash !== target) history.pushState(null, '', target)
        locale = language
        try { localStorage.setItem('agent-language', language) } catch { /* The current visit still uses the chosen language. */ }
        activePath = path
        if (path && !openTabs.includes(path)) openTabs.push(path)
        render()
      }

      function readRoute() {
        const match = location.hash.match(/^#\/(es|en)\/(.+)$/)
        if (!match) return
        const requestedPath = decodeURIComponent(match[2])
        const path = canonicalPath(requestedPath)
        if (path !== '_empty' && !byPath[path]) {
          history.replaceState(null, '', linkFor('README.md', match[1]))
          locale = match[1]
          activePath = 'README.md'
          render()
          return
        }
        locale = match[1]
        const canonicalHash = path === '_empty' ? `#/${locale}/_empty` : linkFor(path, locale)
        if (location.hash !== canonicalHash) history.replaceState(null, '', canonicalHash)
        activePath = path === '_empty' ? null : path
        if (activePath && !openTabs.includes(activePath)) openTabs.push(activePath)
        render()
      }

      function setMobileSidebarOpen(isOpen) {
        const open = mobileViewport.matches && isOpen
        workbench.dataset.mobileSidebarOpen = String(open)
        scrim.hidden = !open
        filesToggle.setAttribute('aria-expanded', String(open))
        sidebar.inert = mobileViewport.matches && !open
      }

      function make(tag, className, text) {
        const node = document.createElement(tag)
        if (className) node.className = className
        if (text != null) node.textContent = text
        return node
      }

      async function copyText(value) {
        if (navigator.clipboard?.writeText) {
          try { await navigator.clipboard.writeText(value); return } catch { /* Try the selection fallback. */ }
        }
        const field = make('textarea')
        field.value = value
        field.setAttribute('readonly', '')
        field.style.position = 'fixed'
        field.style.left = '-9999px'
        document.body.append(field)
        let copied = false
        try { field.select(); copied = document.execCommand('copy') } finally { field.remove() }
        if (!copied) throw new Error('Clipboard unavailable')
      }

      function closeBreadcrumbMenu(restoreFocus = false) {
        if (breadcrumbMenu.hidden) return
        breadcrumbMenu.hidden = true
        openBreadcrumbTrigger?.setAttribute('aria-expanded', 'false')
        if (restoreFocus && openBreadcrumbTrigger?.isConnected) openBreadcrumbTrigger.focus()
        openBreadcrumbTrigger = null
      }

      function folderContents(folderPath) {
        const prefix = folderPath ? `${folderPath}/` : ''
        const files = []
        const folders = new Set()
        for (const document of profileDocuments) {
          if (!document.path.startsWith(prefix)) continue
          const rest = document.path.slice(prefix.length)
          if (!rest.includes('/')) files.push(document.path)
          else folders.add(`${prefix}${rest.split('/')[0]}`)
        }
        if (!folderPath) {
          const rank = (path) => { const index = rootFileOrder.indexOf(path); return index < 0 ? rootFileOrder.length : index }
          files.sort((first, second) => rank(first) - rank(second))
        }
        return { files, folders: [...folders] }
      }

      function fillBreadcrumbMenu(container, folderPath) {
        const { files, folders } = folderContents(folderPath)
        for (const path of files) {
          const fileButton = make('button', 'breadcrumb-menu-row breadcrumb-menu-file')
          fileButton.type = 'button'
          fileButton.dataset.file = path
          if (path === activePath) fileButton.setAttribute('aria-current', 'page')
          fileButton.append(make('span', 'breadcrumb-menu-indent'), make('span', 'file-glyph ui-icon'), make('span', 'breadcrumb-menu-name', displayPath(path).split('/').at(-1)))
          fileButton.addEventListener('click', () => {
            routeTo(path)
            const heading = document.querySelector('.readme-preview:not([hidden]) h1, .profile-preview:not([hidden]) h1')
            if (heading) { heading.tabIndex = -1; heading.focus() }
          })
          container.append(fileButton)
        }
        for (const path of folders) {
          const wrapper = make('div', 'breadcrumb-menu-group')
          const folderButton = make('button', 'breadcrumb-menu-row breadcrumb-menu-subfolder')
          folderButton.type = 'button'
          folderButton.dataset.folder = path.split('/').at(-1)
          folderButton.setAttribute('aria-expanded', 'false')
          folderButton.setAttribute('aria-label', `${locale === 'es' ? 'Mostrar carpeta' : 'Show folder'} ${displayFolder(path)}`)
          folderButton.append(make('span', 'breadcrumb-menu-chevron', '›'), make('span', 'folder-glyph ui-icon'), make('span', 'breadcrumb-menu-name', displayFolder(path.split('/').at(-1))))
          const children = make('div', 'breadcrumb-menu-children')
          children.hidden = true
          folderButton.addEventListener('click', () => {
            const opening = children.hidden
            if (opening && !children.childElementCount) fillBreadcrumbMenu(children, path)
            children.hidden = !opening
            folderButton.setAttribute('aria-expanded', String(opening))
          })
          wrapper.append(folderButton, children)
          container.append(wrapper)
        }
      }

      function toggleBreadcrumbMenu(trigger, folderPath) {
        if (openBreadcrumbTrigger === trigger && !breadcrumbMenu.hidden) { closeBreadcrumbMenu(); return }
        closeBreadcrumbMenu()
        breadcrumbMenuList.replaceChildren()
        fillBreadcrumbMenu(breadcrumbMenuList, folderPath)
        const folderName = folderPath ? displayFolder(folderPath.split('/').at(-1)) : 'Juan'
        document.querySelector('#breadcrumb-menu-title').textContent = `${folderName}/`
        document.querySelector('#breadcrumb-menu-hint').textContent = locale === 'es' ? 'Elige un archivo' : 'Choose a file'
        breadcrumbMenu.setAttribute('aria-label', `${locale === 'es' ? 'Archivos en' : 'Files in'} ${folderName}`)
        breadcrumbMenu.hidden = false
        const bounds = breadcrumbs.getBoundingClientRect()
        const triggerBounds = trigger.getBoundingClientRect()
        const menuWidth = breadcrumbMenu.getBoundingClientRect().width
        breadcrumbMenu.style.left = `${Math.max(10, Math.min(triggerBounds.left - bounds.left, bounds.width - menuWidth - 10))}px`
        trigger.setAttribute('aria-expanded', 'true')
        openBreadcrumbTrigger = trigger
        breadcrumbMenuList.querySelector('button')?.focus()
      }

      function closeTab(path) {
        const index = openTabs.indexOf(path)
        if (index < 0) return
        openTabs.splice(index, 1)
        if (path === activePath) routeTo(openTabs[Math.min(index, openTabs.length - 1)] || null)
        else renderTabs()
      }

      function renderTabs() {
        tabsList.replaceChildren()
        openTabs.forEach((path) => {
          const tab = make('div', 'editor-tab')
          tab.dataset.file = path
          if (path === activePath) tab.dataset.active = 'true'
          const open = make('button', 'tab-open')
          open.type = 'button'
          open.setAttribute('aria-label', `${locale === 'es' ? 'Abrir' : 'Open'} ${displayPath(path)}`)
          open.append(make('span', 'file-glyph ui-icon'), make('span', 'editor-tab-name', displayPath(path).split('/').at(-1)))
          open.addEventListener('click', () => routeTo(path))
          const close = make('button', 'tab-close', '×')
          close.type = 'button'
          close.setAttribute('aria-label', `${locale === 'es' ? 'Cerrar' : 'Close'} ${displayPath(path)}`)
          close.addEventListener('click', () => closeTab(path))
          tab.addEventListener('mousedown', (event) => { if (event.button === 1) event.preventDefault() })
          tab.addEventListener('auxclick', (event) => {
            if (event.button !== 1) return
            event.preventDefault()
            closeTab(path)
          })
          tab.append(open, close)
          tabsList.append(tab)
        })
      }

      function renderBreadcrumb() {
        closeBreadcrumbMenu()
        breadcrumbPath.replaceChildren()
        const parts = activePath?.split('/') || []
        breadcrumbRoot.setAttribute('aria-label', locale === 'es' ? 'Mostrar archivos de Juan' : 'Show files in Juan')
        for (let index = 0; index < parts.length - 1; index++) {
          const folder = parts[index]
          const folderPath = parts.slice(0, index + 1).join('/')
          const folderButton = make('button', 'breadcrumb-folder', displayFolder(folder))
          folderButton.type = 'button'
          folderButton.setAttribute('aria-controls', 'breadcrumb-menu')
          folderButton.setAttribute('aria-expanded', 'false')
          folderButton.setAttribute('aria-label', `${locale === 'es' ? 'Mostrar archivos de' : 'Show files in'} ${displayFolder(folderPath)}`)
          folderButton.addEventListener('click', () => toggleBreadcrumbMenu(folderButton, folderPath))
          breadcrumbPath.append(make('span', 'breadcrumb-separator', '›'), folderButton)
        }
        breadcrumbFile.textContent = activePath ? displayPath(activePath).split('/').at(-1) : '—'
        breadcrumbCurrentIcon.dataset.file = activePath || ''
      }

      function renderReadme() {
        const intro = locale === 'es' ? readmeSpanish : readmeContent
        const heading = readmePreview.querySelector('.readme-copy h1')
        heading.firstChild.textContent = intro.greeting
        heading.querySelector('em').textContent = intro.invitation
        readmePreview.querySelector('.readme-lead').textContent = intro.lead
        readmePreview.querySelector('.readme-guide p').textContent = intro.guide
        readmePreview.querySelector('.readme-bottom-label').textContent = locale === 'es' ? 'Nota de desarrollo' : 'Development note'
        const note = readmePreview.querySelector('.readme-bottom p')
        const creditLink = make('a', '', locale === 'es' ? 'Créditos de iconos' : 'Icon credits')
        creditLink.href = `${baseUrl}icons/codicons/ATTRIBUTION.txt`
        note.replaceChildren(document.createTextNode(locale === 'es' ? 'Esta versión sigue en desarrollo. ' : 'This version is still in development. '), creditLink)
        readmePreview.querySelector('.readme-agent-link').textContent = locale === 'es' ? 'Para agentes ↗' : 'For agents ↗'
        readmePreview.querySelector('.readme-routes').setAttribute('aria-label', locale === 'es' ? 'Empieza a explorar' : 'Start exploring')
        const routeNames = locale === 'es' ? ['Trayectoria', 'Proyectos', 'Sobre mí', 'Contacto'] : ['Trajectory', 'Projects', 'About me', 'Contact']
        readmePreview.querySelectorAll('[data-readme-file]').forEach((link, index) => {
          link.textContent = routeNames[index]
          link.href = linkFor(link.dataset.readmeFile)
        })
        const entry = byPath['README.md'][locale]
        readmeExplore.replaceChildren(make('p', 'readme-facts', entry.lead))
        const overview = make('div', 'readme-overview')
        for (const section of entry.sections) {
          const block = make('section', 'readme-section')
          block.append(make('h2', '', section.title), make('p', '', section.body))
          overview.append(block)
        }
        readmeExplore.append(overview)
        renderBrain(readmeExplore)
        const links = make('div', 'readme-links')
        for (const link of entry.links) {
          const anchor = make('a', 'profile-link', `${link.label} ↗`)
          anchor.href = link.url
          anchor.target = '_blank'
          anchor.rel = 'noopener noreferrer'
          links.append(anchor)
        }
        readmeExplore.append(links)
        readmeExplore.setAttribute('aria-label', locale === 'es' ? 'Explorar README' : 'Explore the README')
      }

      function renderProfile() {
        cancelMarkerAnimation()
        stopAutoScroll()
        if (routeFrame !== null) cancelAnimationFrame(routeFrame)
        routeFrame = null
        if (routeLayoutFrame !== null) cancelAnimationFrame(routeLayoutFrame)
        routeLayoutFrame = null
        routeResizeObserver?.disconnect()
        routeResizeObserver = null
        routeState = null
        profilePreview.replaceChildren()
        if (!activePath) return
        const entry = byPath[activePath][locale]
        const layout = activePath === 'README.md' ? 'overview'
          : activePath === 'AGENTS.md' ? 'agents'
          : activePath === 'SOUL.md' ? 'soul'
          : activePath === 'Trajectory.md' ? 'experience'
          : activePath === 'Contact.md' ? 'contact'
          : activePath === 'skills/README.md' ? 'skills'
          : activePath.startsWith('skills/') ? 'skill-detail'
          : activePath === 'projects/README.md' ? 'projects'
          : 'project-detail'
        profilePreview.dataset.layout = layout
        profilePreview.dataset.file = activePath
        delete editorScroll.dataset.directPathInput
        if (layout === 'experience' && directPathInputEnabled) editorScroll.scrollTop = 0
        editorScroll.dataset.page = layout
        if (layout === 'experience' && directPathInputEnabled && !reducedMotion.matches && !mobileViewport.matches) editorScroll.dataset.directPathInput = 'true'
        const heading = make('header', 'profile-heading')
        heading.append(make('p', 'profile-eyebrow', entry.eyebrow), make('h1', '', entry.title), make('p', 'profile-lead', entry.lead))
        if (layout !== 'experience') profilePreview.append(heading)

        if (layout === 'experience') renderExperience(entry)
        else if (layout === 'soul') renderSoul(entry)
        else if (layout === 'skills') renderLinkedAreas(entry, ['skills/infrastructure.md', 'skills/ci-cd.md', 'skills/applied-ai.md', 'skills/programming.md'], 'skill-area')
        else if (layout === 'projects') renderLinkedAreas(entry, ['projects/jarvis.md', 'projects/payroll-extractor.md'], 'project-area')
        else renderEditorialSections(entry, layout)

        if (layout !== 'experience' && entry.links.length) {
          const links = make('div', 'profile-links')
          entry.links.forEach((link) => {
            if (link.action === 'copy') {
              const button = make('button', 'profile-link profile-email-copy', link.value)
              button.type = 'button'
              button.setAttribute('aria-label', `${locale === 'es' ? 'Copiar correo' : 'Copy email'}: ${link.value}`)
              const status = make('span', 'visually-hidden')
              status.setAttribute('role', 'status')
              button.append(status)
              let feedbackTimeout
              button.addEventListener('click', async () => {
                clearTimeout(feedbackTimeout)
                try {
                  await copyText(link.value)
                  button.dataset.status = locale === 'es' ? 'Copiado' : 'Copied'
                  status.textContent = locale === 'es' ? 'Correo copiado al portapapeles' : 'Email copied to clipboard'
                } catch {
                  button.dataset.status = locale === 'es' ? 'No se pudo copiar' : 'Could not copy'
                  status.textContent = locale === 'es' ? 'No se pudo copiar el correo' : 'Could not copy the email'
                }
                feedbackTimeout = setTimeout(() => {
                  delete button.dataset.status
                  status.textContent = ''
                }, 2400)
              })
              links.append(button)
              return
            }
            const anchor = make('a', 'profile-link', `${link.label} ↗`)
            anchor.href = link.url
            if (link.url.startsWith('https://')) { anchor.target = '_blank'; anchor.rel = 'noopener noreferrer' }
            links.append(anchor)
          })
          profilePreview.append(links)
        }
        if (activePath === 'AGENTS.md') {
          const agentLink = make('a', 'markdown-link', locale === 'es' ? 'Abrir los documentos enlazados ↗' : 'Open the linked documents ↗')
          agentLink.href = `${baseUrl}for-agents/read/${locale}/AGENTS/`
          profilePreview.append(agentLink)
        }
      }

      function renderEditorialSections(entry, layout) {
        const container = make('div', `profile-sections profile-sections-${layout}`)
        entry.sections.forEach((section) => {
          const block = make('section', 'profile-section')
          block.append(make('h2', '', section.title), make('p', '', section.body))
          container.append(block)
        })
        profilePreview.append(container)
      }

      function renderSoul(entry) {
        const container = make('div', 'soul-chapters')
        let chapterIndex = 0
        entry.sections.forEach((section) => {
          section.body.split(/\n\s*\n/).filter(Boolean).forEach((paragraph, paragraphIndex) => {
            const chapter = make('section', 'soul-chapter')
            const text = make('div', 'soul-chapter-copy')
            if (paragraphIndex === 0) text.append(make('h2', '', section.title))
            text.append(make('p', '', paragraph))
            const frame = make('figure', 'soul-photo')
            const image = section.photos?.[paragraphIndex] || (paragraphIndex === 0 ? section.photo : null)
            if (image?.src) {
              const photo = make('img')
              photo.src = `${baseUrl}${image.src.replace(/^\//, '')}`
              photo.alt = image.alt?.[locale] || ''
              photo.loading = 'lazy'
              frame.append(photo)
              if (image.caption?.[locale]) frame.append(make('figcaption', '', image.caption[locale]))
            } else {
              frame.classList.add('soul-photo-pending')
              frame.append(make('span', 'soul-photo-symbol', '＋'), make('figcaption', '', locale === 'es' ? 'Foto personal pendiente' : 'Personal photo to come'))
            }
            chapter.dataset.side = chapterIndex++ % 2 === 0 ? 'right' : 'left'
            chapter.append(text, frame)
            container.append(chapter)
          })
        })
        profilePreview.append(container)
      }

      function renderLinkedAreas(entry, paths, className) {
        const list = make('div', `${className}-list`)
        entry.sections.forEach((section, index) => {
          const path = paths[index]
          const link = make('a', className)
          link.href = linkFor(path)
          link.dataset.file = path
          link.append(make('span', 'file-glyph ui-icon'), make('h2', '', section.title), make('p', '', section.body), make('span', `${className}-open`, locale === 'es' ? 'Abrir archivo ↗' : 'Open file ↗'))
          list.append(link)
        })
        profilePreview.append(list)
      }

      function experienceStopContent(stop, entry) {
        if (stop.sectionIndex == null) return { ...stop[locale], duration: stop.duration?.[locale] }
        const section = entry.sections[stop.sectionIndex]
        const parts = section.title.split(' · ')
        return {
          title: parts.shift() || section.title,
          role: parts.shift() || '',
          period: parts.join(' · '),
          body: section.body,
          ...stop[locale],
          duration: stop.duration?.[locale],
        }
      }

      function svgPart(tag, className) {
        const node = document.createElementNS('http://www.w3.org/2000/svg', tag)
        node.setAttribute('class', className)
        return node
      }

      function updateRouteProgress() {
        if (!routeState?.length) return
        if (routeState.directPathInput) {
          const distance = Math.max(0, Math.min(routeState.length, routeState.markerDistance))
          const samplePosition = distance / routeState.length * (routeState.motion.points.length - 1)
          const index = Math.floor(samplePosition)
          const next = Math.min(routeState.motion.points.length - 1, index + 1)
          const fraction = samplePosition - index
          const first = routeState.motion.points[index]
          const second = routeState.motion.points[next]
          const point = {
            x: first.x + (second.x - first.x) * fraction,
            y: first.y + (second.y - first.y) * fraction,
          }
          // Input owns path distance. The content never drives the marker.
          const camera = timelineCameraEnabled ? Math.max(0, point.y - routeState.motion.points[0].y) : 0
          routeState.camera = camera
          routeState.route.style.transform = `translate3d(0, ${-camera}px, 0)`
          routeState.progress.style.strokeDashoffset = String(routeState.length - distance)
          routeState.cursor.style.transform = `translate3d(${point.x}px, ${point.y}px, 0) translate(-50%, -50%)`
          routeState.badge.style.transform = `translate3d(${point.x + 20}px, ${point.y}px, 0) translateY(-50%)`
          routeState.logoPeriods.forEach((period) => {
            const visible = distance >= period.start && distance <= period.end
            if (period.visible === visible) return
            period.logo.hidden = !visible
            period.visible = visible
          })
          return
        }
        if (!routeState.guided || !reducedMotion.matches) routeState.lastScroll = editorScroll.scrollTop
        const { route, progress, cursor, badge, stops, stopPointIndices, eventDistances, motion, length, startScroll } = routeState
        if (!routeState.guided || reducedMotion.matches) {
          route.style.transform = ''
          if (routeState.currentStop !== null) stops[routeState.currentStop].dataset.current = 'false'
          routeState.currentStop = null
          return
        }
        const travelled = Math.max(0, Math.min(length, editorScroll.scrollTop - startScroll))
        routeState.travelled = travelled
        const samplePosition = travelled / length * (motion.points.length - 1)
        const sampleIndex = Math.floor(samplePosition)
        const nextIndex = Math.min(motion.points.length - 1, sampleIndex + 1)
        const fraction = samplePosition - sampleIndex
        const point = {
          x: motion.points[sampleIndex].x + (motion.points[nextIndex].x - motion.points[sampleIndex].x) * fraction,
          y: motion.points[sampleIndex].y + (motion.points[nextIndex].y - motion.points[sampleIndex].y) * fraction,
        }
        const pathCamera = motion.cameraY[sampleIndex] + (motion.cameraY[nextIndex] - motion.cameraY[sampleIndex]) * fraction - routeState.anchor
        const beforePath = Math.min(0, editorScroll.scrollTop - startScroll)
        const afterPath = Math.max(0, editorScroll.scrollTop - startScroll - length)
        // Sticky owns the viewport. Every object uses this same sampled camera;
        // there is no compensating transform for the browser's native scroll.
        const camera = Math.max(0, pathCamera + beforePath + Math.min(routeState.tail, afterPath))
        routeState.camera = camera
        route.style.transform = `translate3d(0, ${-camera}px, 0)`
        progress.style.strokeDashoffset = String(length - travelled)
        cursor.style.transform = `translate3d(${point.x}px, ${point.y}px, 0) translate(-50%, -50%)`
        badge.style.transform = `translate3d(${point.x + 20}px, ${point.y}px, 0) translateY(-50%)`
        routeState.logoPeriods.forEach((period) => {
          const visible = travelled >= period.start && travelled <= period.end
          if (period.visible === visible) return
          period.logo.hidden = !visible
          period.visible = visible
        })
        let nearest = 0
        for (let index = 1; index < stops.length; index++) {
          if (Math.abs(eventDistances[stopPointIndices[index]] - travelled) < Math.abs(eventDistances[stopPointIndices[nearest]] - travelled)) nearest = index
        }
        if (nearest !== routeState.currentStop) {
          if (routeState.currentStop !== null) stops[routeState.currentStop].dataset.current = 'false'
          stops[nearest].dataset.current = 'true'
          routeState.currentStop = nearest
        }
      }

      function queueRouteProgress() {
        if (routeFrame !== null || !routeState) return
        routeFrame = requestAnimationFrame(() => {
          routeFrame = null
          updateRouteProgress()
        })
      }

      function cancelMarkerAnimation() {
        if (markerAnimationFrame !== null) cancelAnimationFrame(markerAnimationFrame)
        if (markerInertiaFrame !== null) cancelAnimationFrame(markerInertiaFrame)
        markerAnimationFrame = null
        markerAnimationTime = null
        markerInertiaFrame = null
        markerInertiaTime = null
      }

      function stopAutoScroll() {
        if (autoScrollFrame !== null) cancelAnimationFrame(autoScrollFrame)
        autoScrollFrame = null
        autoScrollAnchorY = null
        autoScrollPointerY = null
        autoScrollTime = null
        delete editorScroll.dataset.autoscroll
      }

      function animateAutoScroll(timestamp) {
        autoScrollFrame = null
        if (autoScrollAnchorY === null || !routeState?.directPathInput || document.hidden) return
        const offset = autoScrollPointerY - autoScrollAnchorY
        const velocity = Math.sign(offset) * Math.min(1.8, Math.max(0, Math.abs(offset) - 12) * 0.012)
        if (!velocity) { autoScrollTime = null; return }
        const elapsed = Math.min(50, Math.max(0, timestamp - (autoScrollTime ?? timestamp - 16)))
        autoScrollTime = timestamp
        advanceMarker(velocity * elapsed)
        autoScrollFrame = requestAnimationFrame(animateAutoScroll)
      }

      function setMarkerDistance(distance) {
        if (!routeState?.directPathInput || !routeState.length) return
        cancelMarkerAnimation()
        routeState.markerDistance = Math.max(0, Math.min(routeState.length, distance))
        routeState.targetDistance = routeState.markerDistance
        queueRouteProgress()
      }

      function animateMarker(timestamp) {
        markerAnimationFrame = null
        if (!routeState?.directPathInput || document.hidden) return
        const elapsed = Math.min(50, Math.max(0, timestamp - (markerAnimationTime ?? timestamp - 16)))
        markerAnimationTime = timestamp
        const remaining = routeState.targetDistance - routeState.markerDistance
        const fraction = 1 - Math.exp(-elapsed / routeState.motionTimeConstant)
        routeState.markerDistance += remaining * fraction
        if (Math.abs(routeState.targetDistance - routeState.markerDistance) < 0.35) {
          routeState.markerDistance = routeState.targetDistance
          markerAnimationTime = null
        } else markerAnimationFrame = requestAnimationFrame(animateMarker)
        updateRouteProgress()
      }

      function advanceMarker(distance, smooth = false, timeConstant = 90) {
        if (!routeState?.directPathInput || !routeState.length || !Number.isFinite(distance)) return
        if (!smooth) {
          setMarkerDistance(routeState.markerDistance + distance)
          return
        }
        if (markerInertiaFrame !== null) {
          cancelAnimationFrame(markerInertiaFrame)
          markerInertiaFrame = null
          markerInertiaTime = null
        }
        const pending = routeState.targetDistance - routeState.markerDistance
        // A reversal starts at the visible point instead of finishing the old impulse.
        if (pending && Math.sign(pending) !== Math.sign(distance)) routeState.targetDistance = routeState.markerDistance
        routeState.targetDistance = Math.max(0, Math.min(routeState.length, routeState.targetDistance + distance))
        routeState.motionTimeConstant = timeConstant
        if (markerAnimationFrame === null) markerAnimationFrame = requestAnimationFrame(animateMarker)
      }

      function queueRouteLayout() {
        if (routeLayoutFrame !== null || !routeState) return
        routeLayoutFrame = requestAnimationFrame(() => {
          routeLayoutFrame = null
          layoutExperienceRoute()
        })
      }

      function experienceMonth(date) {
        const [year, month] = date.split('-').map(Number)
        return year * 12 + month
      }

      // Geometry is sampled only on layout. Camera and marker share path distance,
      // so horizontal portions hold the scene still, without temporal smoothing.
      function sampleRouteMotion(line, length) {
        const count = Math.max(2, Math.ceil(length / 12))
        const points = Array.from({ length: count + 1 }, (_, index) => {
          const point = line.getPointAtLength(length * index / count)
          return { x: point.x, y: point.y }
        })
        const cameraY = []
        points.forEach((point, index) => {
          cameraY.push(Math.min(points.at(-1).y, Math.max(index ? cameraY[index - 1] : point.y, point.y)))
        })
        return { points, cameraY }
      }

      function routeDistanceAtY(y) {
        const { motion, length } = routeState
        const samples = motion.cameraY
        let low = 0
        let high = samples.length - 1
        while (high - low > 1) {
          const middle = Math.floor((low + high) / 2)
          if (samples[middle] < y) low = middle
          else high = middle
        }
        const gap = samples[high] - samples[low]
        const fraction = gap > 0 ? Math.max(0, Math.min(1, (y - samples[low]) / gap)) : 0
        return (low + fraction) / (samples.length - 1) * length
      }

      function dateToRouteDistance(date) {
        const { eventDates, eventDistances, length } = routeState
        const target = experienceMonth(date)
        if (target <= experienceMonth(eventDates[0])) return 0
        for (let index = 1; index < eventDates.length; index++) {
          const end = experienceMonth(eventDates[index])
          if (target > end) continue
          const start = experienceMonth(eventDates[index - 1])
          const fraction = end === start ? 1 : (target - start) / (end - start)
          return eventDistances[index - 1] + (eventDistances[index] - eventDistances[index - 1]) * fraction
        }
        return length
      }

      function layoutExperienceRoute() {
        if (!routeState) return
        const { route, shell, svg, line, progress, pins, eventIds } = routeState
        routeState.directPathInput = directPathInputEnabled && !reducedMotion.matches && !mobileViewport.matches
        if (routeState.directPathInput) {
          if (editorScroll.scrollTop) editorScroll.scrollTop = 0
          editorScroll.dataset.directPathInput = 'true'
        } else delete editorScroll.dataset.directPathInput
        const previousLength = routeState.length
        const previousMarkerFraction = routeState.directPathInput && previousLength ? routeState.markerDistance / previousLength : 0
        const previousTargetFraction = routeState.directPathInput && previousLength ? routeState.targetDistance / previousLength : 0
        const previousScroll = routeState.guided && reducedMotion.matches ? (routeState.lastScroll ?? editorScroll.scrollTop) : editorScroll.scrollTop
        let previousPosition = null
        if (!routeState.directPathInput && previousLength && previousScroll >= routeState.pinStart) {
          let distance = Math.max(0, Math.min(previousLength, previousScroll - routeState.startScroll))
          if (!routeState.guided) distance = routeDistanceAtY(previousScroll - routeState.pinStart + routeState.anchor)
          if (routeState.guided && previousScroll < routeState.startScroll) {
            previousPosition = { phase: 'entry', fraction: (previousScroll - routeState.pinStart) / (routeState.leadIn || 1) }
          } else if (routeState.guided && previousScroll > routeState.startScroll + previousLength) {
            previousPosition = { phase: 'exit', offset: previousScroll - routeState.startScroll - previousLength }
          } else {
            let index = 0
            while (index < routeState.eventDistances.length - 2 && routeState.eventDistances[index + 1] < distance) index++
            const start = routeState.eventDistances[index]
            const end = routeState.eventDistances[index + 1]
            previousPosition = { phase: 'path', index, fraction: (distance - start) / (end - start || 1) }
          }
        }
        const bounds = route.getBoundingClientRect()
        if (!bounds.width || !editorScroll.clientHeight) return
        const points = pins.map((pin) => {
          const rect = pin.getBoundingClientRect()
          return { x: rect.left + rect.width / 2 - bounds.left, y: rect.top + rect.height / 2 - bounds.top }
        })
        if (points.length < 2) return
        svg.setAttribute('viewBox', `0 0 ${bounds.width} ${bounds.height}`)
        let d = `M ${points[0].x} ${points[0].y}`
        const eventDistances = [0]
        for (let index = 1; index < points.length; index++) {
          const previous = points[index - 1]
          const current = points[index]
          const gap = current.y - previous.y
          if (eventIds[index - 1] === 'thinkia-end' && eventIds[index] === 'kontaktu') {
            const outside = Math.min(previous.x, current.x) - Math.min(14, bounds.width * 0.012)
            d += ` C ${outside} ${previous.y + gap * .28}, ${outside} ${current.y - gap * .28}, ${current.x} ${current.y}`
          } else {
            const midway = previous.y + gap / 2
            const bend = (previous.x + current.x) / 2 + (index % 2 ? 1 : -1) * Math.min(24, bounds.width * 0.025)
            d += ` C ${previous.x} ${previous.y + gap * .27}, ${bend} ${midway - gap * .13}, ${bend} ${midway}`
            d += ` C ${bend} ${midway + gap * .13}, ${current.x} ${current.y - gap * .27}, ${current.x} ${current.y}`
          }
          line.setAttribute('d', d)
          eventDistances.push(line.getTotalLength())
        }
        progress.setAttribute('d', d)
        routeState.points = points
        routeState.eventDistances = eventDistances
        routeState.length = eventDistances.at(-1)
        routeState.motion = sampleRouteMotion(line, routeState.length)
        progress.style.strokeDasharray = String(routeState.length)

        if (routeState.directPathInput) {
          shell.dataset.guided = 'false'
          routeState.guided = false
          routeState.logoPeriods = [...routeState.badge.querySelectorAll('[data-active-start]')].map((logo) => ({
            logo,
            start: dateToRouteDistance(logo.dataset.activeStart),
            end: dateToRouteDistance(logo.dataset.activeEnd),
            visible: null,
          }))
          routeState.markerDistance = previousMarkerFraction * routeState.length
          routeState.targetDistance = previousTargetFraction * routeState.length
          updateRouteProgress()
          if (Math.abs(routeState.targetDistance - routeState.markerDistance) > 0.35 && markerAnimationFrame === null) {
            markerAnimationFrame = requestAnimationFrame(animateMarker)
          }
          return
        }

        const viewHeight = editorScroll.clientHeight
        const anchor = Math.max(0, Math.min(viewHeight * 0.43, points[0].y))
        const leadIn = points[0].y - anchor
        const contentBottom = Math.max(bounds.height, ...pins.map((pin) => pin.parentElement.getBoundingClientRect().bottom - bounds.top))
        const tail = Math.max(0, contentBottom + 18 - (points.at(-1).y - anchor) - viewHeight)
        const scrollRange = leadIn + routeState.length + tail
        const guided = !reducedMotion.matches && !mobileViewport.matches
        shell.dataset.guided = String(guided)
        shell.style.setProperty('--route-viewport-height', `${viewHeight}px`)
        shell.style.setProperty('--route-scene-height', `${viewHeight + scrollRange}px`)
        const shellRect = shell.getBoundingClientRect()
        const scrollRect = editorScroll.getBoundingClientRect()
        const pinStart = editorScroll.scrollTop + shellRect.top - scrollRect.top - editorScroll.clientTop
        Object.assign(routeState, { guided, viewHeight, anchor, leadIn, tail, scrollRange, pinStart, startScroll: pinStart + leadIn })
        routeState.logoPeriods = [...routeState.badge.querySelectorAll('[data-active-start]')].map((logo) => ({
          logo,
          start: dateToRouteDistance(logo.dataset.activeStart),
          end: dateToRouteDistance(logo.dataset.activeEnd),
          visible: null,
        }))
        if (previousPosition) {
          let distance = 0
          let camera = 0
          if (previousPosition.phase === 'path') {
            const { index, fraction } = previousPosition
            distance = eventDistances[index] + (eventDistances[index + 1] - eventDistances[index]) * fraction
            const position = distance / routeState.length * (routeState.motion.points.length - 1)
            const sample = Math.floor(position)
            const next = Math.min(sample + 1, routeState.motion.points.length - 1)
            camera = routeState.motion.points[sample].y + (routeState.motion.points[next].y - routeState.motion.points[sample].y) * (position - sample) - anchor
          } else if (previousPosition.phase === 'entry') {
            camera = leadIn * previousPosition.fraction
            distance = camera - leadIn
          } else {
            distance = routeState.length + previousPosition.offset
            camera = points.at(-1).y - anchor + previousPosition.offset
          }
          editorScroll.scrollTop = guided ? routeState.startScroll + distance : pinStart + camera
        }
        updateRouteProgress()
      }

      function renderExperience(entry) {
        const monthIndex = (date) => experienceMonth(date) - experienceMonth('2019-01')
        const yearPosition = (date) => 120 + monthIndex(date) * 12
        const scene = make('section', 'experience-scene')
        scene.tabIndex = 0
        scene.setAttribute('aria-label', locale === 'es' ? 'Trayectoria' : 'Journey')
        const route = make('div', 'experience-route')
        const svg = svgPart('svg', 'experience-route-line')
        svg.setAttribute('aria-hidden', 'true')
        const line = svgPart('path', 'experience-route-path')
        const progress = svgPart('path', 'experience-route-progress')
        svg.append(line, progress)
        route.append(svg)
        route.style.setProperty('--route-height', `${yearPosition('2027-06') + 115}px`)
        for (let year = 2019; year <= 2027; year++) {
          const label = make('span', 'experience-year', String(year))
          label.style.setProperty('--event-y', `${yearPosition(`${year}-01`)}px`)
          label.setAttribute('aria-hidden', 'true')
          route.append(label)
        }
        const events = []
        const stops = []
        experienceStops.forEach((stop, index) => {
          const content = experienceStopContent(stop, entry)
          const item = make('article', 'route-stop')
          item.dataset.stop = stop.id
          item.dataset.kind = stop.kind
          item.dataset.side = index % 2 === 0 ? 'left' : 'right'
          item.style.setProperty('--event-y', `${yearPosition(stop.start)}px`)
          const pin = make('span', 'route-pin')
          pin.setAttribute('aria-hidden', 'true')
          const card = make('div', 'route-stop-card')
          const meta = make('div', 'route-meta')
          meta.append(make('span', 'route-place', [content.place, content.period].filter(Boolean).join(' · ') || content.role))
          if (content.duration) meta.append(make('span', 'route-duration', content.duration))
          card.append(
            meta,
            make('span', 'route-title', content.title),
            make('span', 'route-role', content.role),
            ...(content.note ? [make('span', 'route-note', content.note)] : []),
          )
          item.append(pin, card)
          events.push({ date: stop.start, node: item, pin })
          stops.push(item)
        })
        const milestones = [
          { id: 'fp-end', date: '2022-06', es: 'Fin del Grado Superior', en: 'Higher Vocational Diploma completed' },
          { id: '2eyes-end', date: '2024-09', es: 'Fin de la etapa 2EyesVision', en: '2EyesVision chapter ends' },
          { id: 'thinkia-end', date: '2026-08', es: 'Fin de las prácticas en Thinkia', en: 'Thinkia internship ends' },
          { id: 'uam-graduation', date: '2027-06', es: 'Graduación prevista', en: 'Expected graduation' },
        ]
        milestones.forEach((event) => {
          const item = make('div', 'route-milestone')
          item.dataset.id = event.id
          item.style.setProperty('--event-y', `${yearPosition(event.date)}px`)
          const pin = make('span', 'route-milestone-pin')
          pin.setAttribute('aria-hidden', 'true')
          item.append(pin, make('span', 'route-milestone-text', event[locale]))
          events.push({ date: event.date, node: item, pin })
        })
        events.sort((first, second) => monthIndex(first.date) - monthIndex(second.date))
        events.forEach((event) => route.append(event.node))
        const pins = events.map((event) => event.pin)
        const eventIds = events.map((event) => event.node.dataset.stop ?? event.node.dataset.id)
        const stopPointIndices = stops.map((stop) => events.findIndex((event) => event.node === stop))
        const cursor = make('span', 'experience-route-cursor')
        cursor.setAttribute('aria-hidden', 'true')
        route.append(cursor)
        const badge = make('span', 'experience-active-logos')
        badge.setAttribute('aria-hidden', 'true')
        for (const item of [
          { src: 'japan-flag.webp', label: locale === 'es' ? 'Estancia en Japón' : 'Time in Japan', start: '2020-01', end: '2020-06' },
          { src: 'virgen-de-la-paloma-logo.jpg', label: 'IES Virgen de la Paloma', brand: 'fp', start: '2020-09', end: '2022-06' },
          { src: '2eyesvision-mark.webp', label: '2EyesVision', start: '2022-09', end: '2024-09' },
          { src: 'uam-crest.svg', label: 'UAM', start: '2023-09', end: '2027-06' },
          { src: 'thinkia.jpg', label: 'Thinkia', start: '2026-02', end: '2026-08' },
          { src: 'kontaktu.jpg', label: 'Kontaktu AI', start: '2026-10', end: '2027-06' },
        ]) {
          const logo = make('img', 'experience-active-logo')
          logo.src = `${baseUrl}images/${item.src}`
          logo.alt = ''
          logo.title = item.label
          if (item.brand) logo.dataset.brand = item.brand
          logo.dataset.activeStart = item.start
          logo.dataset.activeEnd = item.end
          logo.hidden = true
          badge.append(logo)
        }
        route.append(badge)
        const shell = make('div', 'experience-route-shell')
        const viewport = make('div', 'experience-route-viewport')
        viewport.append(route)
        shell.append(viewport)
        scene.append(shell)
        profilePreview.append(scene)
        routeState = { route, shell, viewport, svg, line, progress, cursor, badge, pins, eventIds, eventDates: events.map((event) => event.date), stops, stopPointIndices, points: [], eventDistances: [], motion: null, logoPeriods: [], currentStop: null, length: 0, startScroll: 0, guided: false, directPathInput: directPathInputEnabled && !reducedMotion.matches && !mobileViewport.matches, markerDistance: 0, targetDistance: 0, motionTimeConstant: 90 }
        routeResizeObserver = new ResizeObserver(queueRouteLayout)
        routeResizeObserver.observe(route)
        routeResizeObserver.observe(editorScroll)
        events.forEach((event) => routeResizeObserver.observe(event.node))
        queueRouteLayout()
      }

      function renderBrain(container) {
        const section = make('section', 'brain-section')
        section.append(
          make('p', 'brain-kicker', locale === 'es' ? 'Markdown brain' : 'Markdown brain'),
          make('h2', '', locale === 'es' ? 'Un perfil, varios caminos' : 'One profile, many paths'),
          make('p', 'brain-intro', locale === 'es'
            ? 'Cada nodo abre un archivo. Las líneas muestran relaciones entre documentos; también puedes seguirlas dentro de cada archivo.'
            : 'Each node opens a file. Lines show relationships between documents; you can also follow them inside each file.'),
        )
        const viewport = make('div', 'brain-viewport')
        const ns = 'http://www.w3.org/2000/svg'
        const svg = document.createElementNS(ns, 'svg')
        svg.setAttribute('viewBox', '0 0 1200 740')
        svg.setAttribute('aria-label', locale === 'es' ? 'Mapa navegable de archivos' : 'Navigable file map')
        const drawnEdges = new Set()
        for (const source of graphNodes) {
          for (const targetPath of source.related) {
            const edgeKey = [source.path, targetPath].sort().join('|')
            if (drawnEdges.has(edgeKey)) continue
            drawnEdges.add(edgeKey)
            const target = graphByPath[targetPath]
            const line = document.createElementNS(ns, 'line')
            line.setAttribute('class', 'brain-edge')
            line.setAttribute('x1', source.x)
            line.setAttribute('y1', source.y)
            line.setAttribute('x2', target.x)
            line.setAttribute('y2', target.y)
            svg.append(line)
          }
        }
        for (const node of graphNodes) {
          const link = document.createElementNS(ns, 'a')
          link.setAttribute('class', `brain-node brain-node-${node.group}`)
          link.setAttribute('href', linkFor(node.path))
          link.setAttribute('aria-label', `${locale === 'es' ? 'Abrir' : 'Open'} ${displayPath(node.path)}`)
          const rect = document.createElementNS(ns, 'rect')
          rect.setAttribute('x', node.x - 82)
          rect.setAttribute('y', node.y - 23)
          rect.setAttribute('width', '164')
          rect.setAttribute('height', '46')
          rect.setAttribute('rx', '12')
          const label = document.createElementNS(ns, 'text')
          label.setAttribute('x', node.x)
          label.setAttribute('y', node.y + 5)
          label.setAttribute('text-anchor', 'middle')
          label.textContent = node.path.endsWith('/README.md') ? `${displayFolder(node.path.split('/')[0])}/` : displayPath(node.path).split('/').at(-1)
          link.append(rect, label)
          svg.append(link)
        }
        viewport.append(svg)
        section.append(viewport)
        const list = make('div', 'brain-mobile-list')
        for (const [group, titleEs, titleEn] of [['root', 'Archivos principales', 'Main files'], ['skills', 'Skills', 'Skills'], ['projects', 'Proyectos', 'Projects']]) {
          const cluster = make('section', 'brain-mobile-cluster')
          cluster.append(make('h3', '', locale === 'es' ? titleEs : titleEn))
          for (const node of graphNodes.filter((item) => item.group === group)) {
            const button = make('button', 'related-file', displayPath(node.path))
            button.type = 'button'
            button.addEventListener('click', () => routeTo(node.path))
            cluster.append(button)
          }
          list.append(cluster)
        }
        section.append(list)
        container.append(section)
      }

      function renderContent() {
        if (activePath !== 'Trajectory.md') {
          cancelMarkerAnimation()
          stopAutoScroll()
          delete editorScroll.dataset.directPathInput
          if (routeFrame !== null) cancelAnimationFrame(routeFrame)
          routeFrame = null
          if (routeLayoutFrame !== null) cancelAnimationFrame(routeLayoutFrame)
          routeLayoutFrame = null
          routeResizeObserver?.disconnect()
          routeResizeObserver = null
          routeState = null
        }
        readmePreview.hidden = true
        readmeExplore.hidden = true
        profilePreview.hidden = true
        emptyEditor.hidden = true
        if (!activePath) { editorScroll.dataset.page = 'empty'; emptyEditor.hidden = false }
        else if (activePath === 'README.md') { editorScroll.dataset.page = 'readme'; readmePreview.hidden = false; readmeExplore.hidden = false; renderReadme() }
        else { profilePreview.hidden = false; renderProfile() }
      }

      function renderChromeLocale() {
        const es = locale === 'es'
        const set = (selector, spanish, english) => { document.querySelector(selector).textContent = es ? spanish : english }
        set('.alpha-label', 'Vista previa · Alpha', 'Preview · Alpha')
        set('.empty-editor h1', 'Todo cerrado por ahora.', 'Everything is closed for now.')
        set('.empty-editor p', 'Abre un archivo del árbol o vuelve a README.', 'Open a file from the tree, or return to README.')
        set('.empty-readme', 'Abrir README.md', 'Open README.md')
        set('.readme-eyebrow span:nth-child(2)', 'README.md', 'README.md')
        set('.statusbar .status-item:first-child', 'Juan · en desarrollo', 'Juan · in development')
        set('#sidebar-title', 'Explorador', 'Explorer')
        set('.mobile-files-toggle span:last-child', 'Explorador', 'Explorer')
        sidebar.setAttribute('aria-label', es ? 'Explorador de archivos' : 'File explorer')
        document.querySelector('.view-content').setAttribute('aria-label', es ? 'Árbol de archivos' : 'File tree')
        document.querySelector('.tabs-bar').setAttribute('aria-label', es ? 'Archivos abiertos' : 'Open files')
        sidebarClose.setAttribute('aria-label', es ? 'Cerrar explorador de archivos' : 'Close file explorer')
        filesToggle.setAttribute('aria-label', es ? 'Abrir explorador de archivos' : 'Open file explorer')
        document.querySelector('.editor').setAttribute('aria-label', es ? 'Portfolio de Juan' : 'Juan’s portfolio')
        document.querySelector('.breadcrumbs').setAttribute('aria-label', es ? 'Ruta del archivo' : 'File path')
        document.querySelector('.titlebar').setAttribute('aria-label', es ? 'Barra de título' : 'Title bar')
        document.querySelector('.statusbar').setAttribute('aria-label', es ? 'Estado del workspace' : 'Workspace status')
        brandButton.setAttribute('aria-label', es ? 'Abrir README.md' : 'Open README.md')
        readmePreview.setAttribute('aria-label', es ? 'Vista previa de README.md' : 'Preview of README.md')
        languageSwitch.setAttribute('aria-label', es ? 'Cambiar idioma a inglés' : 'Switch language to Spanish')
        themeSelect.setAttribute('aria-label', es ? 'Tema visual' : 'Visual theme')
        themeSelect.options[0].textContent = es ? 'VS Code oscuro' : 'VS Code Dark'
        themeSelect.options[1].textContent = es ? 'VS Code claro' : 'VS Code Light'
        themeSelect.options[4].textContent = es ? 'Tema: sistema' : 'Theme: system'
        document.title = 'Juan Larrondo · Portfolio (Alpha)'
      }

      function render() {
        renderChromeLocale()
        languageSwitch.dataset.currentLanguage = locale
        document.documentElement.lang = locale
        editorScroll.setAttribute('aria-label', locale === 'es' ? 'Contenido desplazable del portfolio' : 'Scrollable portfolio content')
        statusLocale.textContent = locale.toUpperCase()
        statusFile.textContent = activePath ? displayPath(activePath) : (locale === 'es' ? 'Sin archivo' : 'No file')
        titlebarLocation.textContent = `${activePath ? displayPath(activePath) : 'Portfolio'} — Juan`
        document.querySelectorAll('.tree-file').forEach((button) => {
          button.querySelector('.tree-file-label').textContent = displayPath(button.dataset.file).split('/').at(-1)
          if (button.dataset.file === activePath) button.setAttribute('aria-current', 'page')
          else button.removeAttribute('aria-current')
        })
        document.querySelector('[data-folder="projects"] span:last-child').textContent = displayFolder('projects')
        renderTabs()
        renderBreadcrumb()
        renderContent()
      }

      themeSelect.value = document.documentElement.dataset.themeChoice || 'system'
      themeSelect.addEventListener('change', () => {
        const choice = themeSelect.value
        document.documentElement.dataset.themeChoice = choice
        document.documentElement.dataset.theme = choice === 'system' ? (systemTheme.matches ? 'light' : 'dark') : choice
        try {
          localStorage.setItem('agent-theme', choice)
        } catch { /* The current visit still uses the selected theme. */ }
      })
      systemTheme.addEventListener('change', (event) => {
        if (document.documentElement.dataset.themeChoice === 'system') document.documentElement.dataset.theme = event.matches ? 'light' : 'dark'
      })
      brandButton.addEventListener('click', () => routeTo('README.md'))
      languageSwitch.addEventListener('click', () => routeTo(activePath, locale === 'es' ? 'en' : 'es'))
      breadcrumbRoot.addEventListener('click', () => toggleBreadcrumbMenu(breadcrumbRoot, ''))
      breadcrumbMenu.addEventListener('keydown', (event) => {
        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return
        const rows = [...breadcrumbMenu.querySelectorAll('.breadcrumb-menu-row')].filter((row) => row.getClientRects().length)
        const current = rows.indexOf(document.activeElement)
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? rows.length - 1 : event.key === 'ArrowDown' ? (current + 1) % rows.length : (current - 1 + rows.length) % rows.length
        rows[next]?.focus()
        event.preventDefault()
      })
      document.addEventListener('pointerdown', (event) => {
        if (!breadcrumbMenu.hidden && !breadcrumbMenu.contains(event.target) && !event.target.closest('.breadcrumb-folder')) closeBreadcrumbMenu()
      })
      editorScroll.addEventListener('mousedown', (event) => {
        if (!routeState?.directPathInput || event.button !== 1 || event.target.closest('a')) return
        event.preventDefault()
        event.stopPropagation()
        if (autoScrollAnchorY !== null) { stopAutoScroll(); return }
        cancelMarkerAnimation()
        autoScrollAnchorY = event.clientY
        autoScrollPointerY = event.clientY
        editorScroll.dataset.autoscroll = 'idle'
      })
      editorScroll.addEventListener('auxclick', (event) => {
        if (routeState?.directPathInput && event.button === 1 && !event.target.closest('a')) event.preventDefault()
      })
      document.addEventListener('mousemove', (event) => {
        if (autoScrollAnchorY === null) return
        autoScrollPointerY = event.clientY
        const offset = autoScrollPointerY - autoScrollAnchorY
        editorScroll.dataset.autoscroll = offset > 12 ? 'down' : offset < -12 ? 'up' : 'idle'
        if (Math.abs(offset) <= 12) {
          if (autoScrollFrame !== null) cancelAnimationFrame(autoScrollFrame)
          autoScrollFrame = null
          autoScrollTime = null
        } else if (autoScrollFrame === null) autoScrollFrame = requestAnimationFrame(animateAutoScroll)
      })
      document.addEventListener('mousedown', () => { if (autoScrollAnchorY !== null) stopAutoScroll() })
      window.addEventListener('blur', stopAutoScroll)
      editorScroll.addEventListener('scroll', () => {
        queueRouteProgress()
      }, { passive: true })
      editorScroll.addEventListener('wheel', (event) => {
        if (!routeState?.directPathInput || event.ctrlKey || event.metaKey || !event.deltaY) return
        if (autoScrollAnchorY !== null) stopAutoScroll()
        if (event.cancelable) event.preventDefault()
        const unit = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16
          : event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? editorScroll.clientHeight : 1
        const delta = event.deltaY * unit
        advanceMarker(delta, true, event.deltaMode === WheelEvent.DOM_DELTA_PIXEL && Math.abs(delta) < 24 ? 42 : 90)
      }, { passive: false })
      let markerTouchY = null
      let markerTouchTime = 0
      let markerTouchVelocity = 0
      editorScroll.addEventListener('touchstart', (event) => {
        if (!routeState?.directPathInput || event.touches.length !== 1) {
          markerTouchY = null
          return
        }
        if (autoScrollAnchorY !== null) stopAutoScroll()
        cancelMarkerAnimation()
        markerTouchY = event.touches[0].clientY
        markerTouchTime = event.timeStamp
        markerTouchVelocity = 0
      }, { passive: true })
      editorScroll.addEventListener('touchmove', (event) => {
        if (!routeState?.directPathInput || markerTouchY === null) return
        if (event.touches.length !== 1) { markerTouchY = null; return }
        const nextY = event.touches[0].clientY
        if (event.cancelable) event.preventDefault()
        const delta = markerTouchY - nextY
        const elapsed = event.timeStamp - markerTouchTime
        if (elapsed > 0) markerTouchVelocity = markerTouchVelocity * 0.35 + Math.max(-3, Math.min(3, delta / elapsed)) * 0.65
        advanceMarker(delta)
        markerTouchY = nextY
        markerTouchTime = event.timeStamp
      }, { passive: false })
      function animateTouchInertia(timestamp) {
        markerInertiaFrame = null
        if (!routeState?.directPathInput || document.hidden) return
        const elapsed = Math.min(50, Math.max(0, timestamp - (markerInertiaTime ?? timestamp - 16)))
        markerInertiaTime = timestamp
        const decay = Math.exp(-elapsed / 170)
        const delta = markerTouchVelocity * 170 * (1 - decay)
        const before = routeState.markerDistance
        routeState.markerDistance = Math.max(0, Math.min(routeState.length, before + delta))
        routeState.targetDistance = routeState.markerDistance
        markerTouchVelocity *= decay
        queueRouteProgress()
        if (Math.abs(markerTouchVelocity) > 0.03 && routeState.markerDistance !== before + delta) markerTouchVelocity = 0
        if (Math.abs(markerTouchVelocity) > 0.03) markerInertiaFrame = requestAnimationFrame(animateTouchInertia)
        else markerInertiaTime = null
      }
      editorScroll.addEventListener('touchend', (event) => {
        if (markerTouchY !== null && !event.touches.length && event.timeStamp - markerTouchTime < 80 && Math.abs(markerTouchVelocity) > 0.1) {
          markerInertiaTime = null
          markerInertiaFrame = requestAnimationFrame(animateTouchInertia)
        }
        markerTouchY = null
      }, { passive: true })
      editorScroll.addEventListener('touchcancel', () => { markerTouchY = null; cancelMarkerAnimation() }, { passive: true })
      editorScroll.addEventListener('keydown', (event) => {
        if (!routeState?.directPathInput || event.defaultPrevented || event.altKey || event.metaKey || event.ctrlKey && !['Home', 'End'].includes(event.key)) return
        if (event.target.closest('input, select, textarea, [contenteditable="true"]')) return
        if (event.code === 'Space' && event.target.closest('button, a')) return
        const page = editorScroll.clientHeight * 0.85
        const step = event.key === 'ArrowDown' ? 48 : event.key === 'ArrowUp' ? -48
          : event.key === 'PageDown' || (event.code === 'Space' && !event.shiftKey) ? page
            : event.key === 'PageUp' || (event.code === 'Space' && event.shiftKey) ? -page
              : event.key === 'Home' ? -Infinity : event.key === 'End' ? Infinity : null
        if (step === null) return
        event.preventDefault()
        if (Number.isFinite(step)) advanceMarker(step, true, 75)
        else setMarkerDistance(step > 0 ? routeState.length : 0)
      })
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden || !routeState?.directPathInput) return
        stopAutoScroll()
        if (markerAnimationFrame !== null) setMarkerDistance(routeState.targetDistance)
        else cancelMarkerAnimation()
      })
      window.addEventListener('resize', () => {
        closeBreadcrumbMenu()
        queueRouteLayout()
      })
      filesToggle.addEventListener('click', () => { setMobileSidebarOpen(true); sidebarClose.focus() })
      sidebarClose.addEventListener('click', () => { setMobileSidebarOpen(false); filesToggle.focus() })
      document.querySelector('.empty-readme').addEventListener('click', () => routeTo('README.md'))
      document.querySelectorAll('[data-folder]').forEach((button) => {
        button.addEventListener('click', () => {
          const list = document.getElementById(button.dataset.target)
          const isExpanded = button.getAttribute('aria-expanded') === 'true'
          button.setAttribute('aria-expanded', String(!isExpanded))
          list.hidden = isExpanded
        })
      })
      document.querySelectorAll('.tree-file').forEach((button) => {
        button.addEventListener('click', () => {
          routeTo(button.dataset.file)
          if (mobileViewport.matches) {
            setMobileSidebarOpen(false)
            const heading = document.querySelector('.readme-preview:not([hidden]) h1, .profile-preview:not([hidden]) h1')
            if (heading) { heading.tabIndex = -1; heading.focus() }
          }
        })
      })
      scrim.addEventListener('click', () => { setMobileSidebarOpen(false); filesToggle.focus() })
      mobileViewport.addEventListener('change', () => { setMobileSidebarOpen(false); queueRouteLayout() })
      reducedMotion.addEventListener('change', queueRouteLayout)
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && autoScrollAnchorY !== null) { stopAutoScroll(); return }
        if (event.key === 'Escape' && !breadcrumbMenu.hidden) { closeBreadcrumbMenu(true); return }
        if (event.key === 'Escape' && workbench.dataset.mobileSidebarOpen === 'true' && mobileViewport.matches) { setMobileSidebarOpen(false); filesToggle.focus() }
      })
      window.addEventListener('popstate', readRoute)
      window.addEventListener('hashchange', readRoute)
      setMobileSidebarOpen(false)
      readRoute()
      render()
    </script>
  </body>
</html>

---
import { getEntry, render } from 'astro:content'
import '../../styles/reader.css'

const index = await getEntry('agentMarkdown', 'index')
if (!index) throw new Error('Falta el índice Markdown de Agent')
const { Content } = await render(index)
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Archivos del portfolio Agent · Juan Larrondo</title>
  </head>
  <body>
    <main class="reader-shell">
      <nav class="reader-top" aria-label="Navegación"><a href="/">← Portfolio</a></nav>
      <article class="reader-markdown"><Content /></article>
    </main>
  </body>
</html>

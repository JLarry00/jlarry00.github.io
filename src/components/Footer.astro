---
import { copy, external, routeFor, type Locale } from '../data/site'
interface Props { locale: Locale }
const { locale } = Astro.props
const t = copy[locale]
---
<footer class="site-footer">
  <div class="container footer__top">
    <p class="footer__invitation">{t.footer.invitation}</p>
    <a class="footer__email" href={`mailto:${external.email}`}>{external.email}</a>
  </div>
  <div class="container footer__bottom">
    <div><p class="footer__label">{t.footer.nav}</p><nav aria-label={t.footer.nav}><a href={routeFor(locale, 'home')}>{t.nav.home}</a><a href={routeFor(locale, 'about')}>{t.nav.about}</a><a href={routeFor(locale, 'projects')}>{t.nav.projects}</a><a href={routeFor(locale, 'approach')}>{t.nav.approach}</a><a href={routeFor(locale, 'contact')}>{t.nav.contact}</a></nav></div>
    <div><p class="footer__label">Online</p><nav aria-label="Online profiles"><a href={external.linkedin}>LinkedIn</a><a href={external.github}>GitHub</a></nav></div>
    <p class="footer__copyright">{t.footer.copyright}</p>
  </div>
</footer>

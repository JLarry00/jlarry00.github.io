---
import { getCollection, render } from 'astro:content'
import profile from '../../../data/profile.json'
import '../../../styles/reader.css'

export async function getStaticPaths() {
  const documents = await getCollection('agentMarkdown')
  return documents.filter((document) => document.id !== 'index').map((document) => ({
    params: { slug: document.id },
    props: { document },
  }))
}

const { document } = Astro.props
const { Content } = await render(document)
const [locale, ...segments] = document.id.split('/')
const documentPath = `${segments.join('/')}.md`
const title = profile.documents.find((item) => item.path === documentPath)?.[locale]?.title ?? documentPath
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · {locale === 'es' ? 'Markdown con formato' : 'Formatted Markdown'} · Juan Larrondo</title>
    <script is:inline>
      try {
        const stored = localStorage.getItem('agent-theme')
        const choice = ['dark', 'light', 'monokai', 'solarized', 'system'].includes(stored) ? stored : 'dark'
        document.documentElement.dataset.theme = choice === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : choice
      } catch { document.documentElement.dataset.theme = 'dark' }
    </script>
  </head>
  <body>
    <main class="reader-shell">
      <nav class="reader-top" aria-label={locale === 'es' ? 'Navegación' : 'Navigation'}>
        <a class="reader-index" href="/for-agents/">← {locale === 'es' ? 'Todos los archivos' : 'All files'}</a>
        <a class="reader-return" href={`/#/${locale}/AGENTS.md`}>{locale === 'es' ? 'AGENTS.md visual' : 'Visual AGENTS.md'} ↗</a>
      </nav>
      <p class="reader-path">{locale.toUpperCase()} / {documentPath}</p>
      <article class="reader-markdown"><Content /></article>
    </main>
  </body>
</html>
